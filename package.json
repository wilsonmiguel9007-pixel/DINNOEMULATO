{
  "name": "dinnoemulator",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "start:desktop": "electron .",
    "build:windows": "electron-builder --win nsis",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "firebase": "^10.12.2"
  },
  "main": "desktop/main.cjs",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dinnorex.dinnoemulator",
    "productName": "DINNOEMULATOR",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}